{
    "globalRandom": 0,
    "events": [
        {
            "delayBefore": 0,
            "name": "Start with the email address",
            "type": "comment"
        },
        {
            "delayBefore": 500,
            "name": "1. click the email icon",
            "type": "click",
            "x": 22,
            "y": 20,
            "duration": 120,
            "randomFactor": 6,
            "anchor": "email",
            "p": 45,
            "maj": 130,
            "min": 120
        },
        {
            "delayBefore": 0,
            "name": "2. wait for the email screen",
            "type": "set",
            "variable": "ready",
            "expression": "waitTextAppear(\"Enter your email address\", 15000)"
        },
        {
            "delayBefore": 400,
            "name": "3-4. type the email address: find the field",
            "type": "focus_field",
            "variable": "chars"
        },
        {
            "delayBefore": 200,
            "name": "  cursor to the end",
            "type": "key",
            "key": "MOVE_END"
        },
        {
            "delayBefore": 0,
            "name": "  backspace over what is there",
            "type": "while",
            "condition": "chars > 0",
            "events": [
                {
                    "delayBefore": 60,
                    "name": "",
                    "type": "key",
                    "key": "DEL"
                },
                {
                    "delayBefore": 0,
                    "name": "",
                    "type": "set",
                    "variable": "chars",
                    "expression": "chars - 1"
                }
            ]
        },
        {
            "delayBefore": 300,
            "name": "3-4. type the email address",
            "type": "text",
            "text": "{email}"
        },
        {
            "delayBefore": 800,
            "name": "5. tap Continue",
            "type": "click",
            "x": 108,
            "y": 21,
            "duration": 120,
            "randomFactor": 6,
            "anchorText": "Continue",
            "p": 45,
            "maj": 130,
            "min": 120
        },
        {
            "delayBefore": 0,
            "name": "Fetch the six digit code and try each one",
            "type": "comment"
        },
        {
            "delayBefore": 0,
            "name": "6. wait for the verification code screen",
            "type": "set",
            "variable": "ready",
            "expression": "waitTextAppear(\"Enter the code\", 15000)"
        },
        {
            "delayBefore": 0,
            "name": "7. wait up to a minute for the codes",
            "type": "http_get",
            "url": "http://192.168.2.2:5553/codes",
            "variable": "raw",
            "timeoutMs": 60000,
            "intervalMs": 2000
        },
        {
            "delayBefore": 0,
            "name": "  keep the ones under two minutes old, best-first",
            "type": "set",
            "variable": "codes",
            "expression": "jq(raw, '[.[] | select(.age_seconds <= 120) | .code]')"
        },
        {
            "delayBefore": 0,
            "name": "8. start at the best code",
            "type": "set",
            "variable": "i",
            "expression": "0"
        },
        {
            "delayBefore": 0,
            "name": "8. try every code until one is accepted",
            "type": "while",
            "condition": "i < count(codes)",
            "events": [
                {
                    "delayBefore": 400,
                    "name": "8.1-8.2 type this code: find the field",
                    "type": "focus_field",
                    "variable": "chars"
                },
                {
                    "delayBefore": 200,
                    "name": "  cursor to the end",
                    "type": "key",
                    "key": "MOVE_END"
                },
                {
                    "delayBefore": 0,
                    "name": "  backspace over what is there",
                    "type": "while",
                    "condition": "chars > 0",
                    "events": [
                        {
                            "delayBefore": 60,
                            "name": "",
                            "type": "key",
                            "key": "DEL"
                        },
                        {
                            "delayBefore": 0,
                            "name": "",
                            "type": "set",
                            "variable": "chars",
                            "expression": "chars - 1"
                        }
                    ]
                },
                {
                    "delayBefore": 300,
                    "name": "8.1-8.2 type this code",
                    "type": "text",
                    "text": "{codes[i]}"
                },
                {
                    "delayBefore": 800,
                    "name": "8.3 tap Continue",
                    "type": "click",
                    "x": 108,
                    "y": 21,
                    "duration": 120,
                    "randomFactor": 6,
                    "anchorText": "Continue",
                    "p": 45,
                    "maj": 130,
                    "min": 120
                },
                {
                    "delayBefore": 1200,
                    "name": "8.4 stop if the birthday screen arrived",
                    "type": "if",
                    "branches": [
                        {
                            "condition": "textAppear(\"your birthday\")",
                            "events": [
                                {
                                    "delayBefore": 0,
                                    "name": "code accepted",
                                    "type": "break"
                                }
                            ]
                        }
                    ],
                    "else": []
                },
                {
                    "delayBefore": 0,
                    "name": "8.5 next code",
                    "type": "set",
                    "variable": "i",
                    "expression": "i + 1"
                }
            ]
        },
